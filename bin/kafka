# Universal Kafka Command-Line Interface
# A unified wrapper for all Kafka CLI tools

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

show_help() {
    cat << EOF
kafka - Universal Kafka Command-Line Interface

Usage: kafka [COMMAND] [OPTIONS]

A simplified, unified interface for Apache Kafka operations.

TOPIC COMMANDS:
  topics                Manage Kafka topics (create, list, describe, delete, alter)

PRODUCER/CONSUMER COMMANDS:
  produce               Send messages to a topic
  consume               Read messages from a topic
  share-consume         Read messages from a topic using share groups

GROUP COMMANDS:
  consumer-groups       Manage consumer groups (list, describe, delete, reset offsets)
  share-groups          Manage share groups (list, describe, delete, reset offsets)
  streams-groups        Manage Kafka Streams groups (list, describe)
  groups                List all groups (consumer, share, and streams)

CONFIGURATION COMMANDS:
  configs               View and modify broker/topic/client/user/ip configurations
  client-metrics        Manipulate and describe client metrics configurations

SECURITY COMMANDS:
  acls                  Manage Access Control Lists for security
  delegation-tokens     Create, renew, expire, or describe delegation tokens

CLUSTER COMMANDS:
  cluster               Display cluster-level information
  broker-api-versions   Retrieve broker version information
  log-dirs              Query log directory usage on brokers
  reassign-partitions   Reassign partitions across brokers
  leader-election       Trigger preferred replica leader election
  metadata-quorum       Describe the metadata quorum
  features              Manage feature flags
  storage               Manage storage and log directories

PERFORMANCE & TESTING COMMANDS:
  consumer-perf-test    Run consumer performance tests
  producer-perf-test    Run producer performance tests
  share-consumer-perf-test  Run share consumer performance tests
  e2e-latency           Measure end-to-end latency
  verifiable-producer   Run a verifiable producer for testing
  verifiable-consumer   Run a verifiable consumer for testing
  verifiable-share-consumer  Run a verifiable share consumer for testing

ADVANCED COMMANDS:
  transactions          Manage transactions
  replica-verification  Validate replica consistency
  delete-records        Delete records from partitions up to a specified offset
  get-offsets           Get topic partition offsets
  dump-log              Dump log file contents
  jmx                   Dump JMX metrics to standard output
  metadata-shell        Interactive metadata shell
  streams-resetter      Reset Kafka Streams application state

GLOBAL OPTIONS:
  --help, -h            Show this help message
  --version, -v         Show version information

EXAMPLES:
  kafka topics --list --bootstrap-server localhost:9092
  kafka produce my-topic --bootstrap-server localhost:9092
  kafka consume my-topic --from-beginning --bootstrap-server localhost:9092
  kafka consumer-groups --describe --group my-group --bootstrap-server localhost:9092
  kafka acls --list --bootstrap-server localhost:9092

For detailed help on any command, run:
  kafka [COMMAND] --help

Documentation: https://kafka.apache.org/documentation/
EOF
}

show_version() {
    # Extract version from one of the jar files or use a default message
    echo "Apache Kafka CLI Tools"
    echo "For version information, run: kafka-topics.sh --version"
}

# Parse command
COMMAND="$1"

if [ $# -eq 0 ] || [ "$COMMAND" = "--help" ] || [ "$COMMAND" = "-h" ]; then
    show_help
    exit 0
fi

if [ "$COMMAND" = "--version" ] || [ "$COMMAND" = "-v" ]; then
    show_version
    exit 0
fi

# Remove the command from arguments
shift

# Map commands to their actual scripts
case "$COMMAND" in
    # Topic commands
    topics|topic)
        exec "$SCRIPT_DIR/kafka-topics.sh" "$@"
        ;;

    # Producer/Consumer commands
    produce|producer|console-producer)
        exec "$SCRIPT_DIR/kafka-console-producer.sh" "$@"
        ;;
    consume|consumer|console-consumer)
        exec "$SCRIPT_DIR/kafka-console-consumer.sh" "$@"
        ;;
    share-consume|share-consumer|console-share-consumer)
        exec "$SCRIPT_DIR/kafka-console-share-consumer.sh" "$@"
        ;;

    # Group commands
    consumer-groups|consumer-group)
        exec "$SCRIPT_DIR/kafka-consumer-groups.sh" "$@"
        ;;
    share-groups|share-group)
        exec "$SCRIPT_DIR/kafka-share-groups.sh" "$@"
        ;;
    streams-groups|streams-group)
        exec "$SCRIPT_DIR/kafka-streams-groups.sh" "$@"
        ;;
    groups|group)
        exec "$SCRIPT_DIR/kafka-groups.sh" "$@"
        ;;

    # Configuration commands
    configs|config)
        exec "$SCRIPT_DIR/kafka-configs.sh" "$@"
        ;;
    client-metrics)
        exec "$SCRIPT_DIR/kafka-client-metrics.sh" "$@"
        ;;

    # Security commands
    acls|acl)
        exec "$SCRIPT_DIR/kafka-acls.sh" "$@"
        ;;
    delegation-tokens|delegation-token|tokens|token)
        exec "$SCRIPT_DIR/kafka-delegation-tokens.sh" "$@"
        ;;

    # Cluster commands
    cluster)
        exec "$SCRIPT_DIR/kafka-cluster.sh" "$@"
        ;;
    broker-api-versions|api-versions)
        exec "$SCRIPT_DIR/kafka-broker-api-versions.sh" "$@"
        ;;
    log-dirs|logdirs)
        exec "$SCRIPT_DIR/kafka-log-dirs.sh" "$@"
        ;;
    reassign-partitions|reassign)
        exec "$SCRIPT_DIR/kafka-reassign-partitions.sh" "$@"
        ;;
    leader-election)
        exec "$SCRIPT_DIR/kafka-leader-election.sh" "$@"
        ;;
    metadata-quorum|quorum)
        exec "$SCRIPT_DIR/kafka-metadata-quorum.sh" "$@"
        ;;
    features|feature)
        exec "$SCRIPT_DIR/kafka-features.sh" "$@"
        ;;
    storage)
        exec "$SCRIPT_DIR/kafka-storage.sh" "$@"
        ;;

    # Performance & Testing commands
    consumer-perf-test|consumer-perf)
        exec "$SCRIPT_DIR/kafka-consumer-perf-test.sh" "$@"
        ;;
    producer-perf-test|producer-perf)
        exec "$SCRIPT_DIR/kafka-producer-perf-test.sh" "$@"
        ;;
    share-consumer-perf-test|share-consumer-perf)
        exec "$SCRIPT_DIR/kafka-share-consumer-perf-test.sh" "$@"
        ;;
    e2e-latency|latency)
        exec "$SCRIPT_DIR/kafka-e2e-latency.sh" "$@"
        ;;
    verifiable-producer)
        exec "$SCRIPT_DIR/kafka-verifiable-producer.sh" "$@"
        ;;
    verifiable-consumer)
        exec "$SCRIPT_DIR/kafka-verifiable-consumer.sh" "$@"
        ;;
    verifiable-share-consumer)
        exec "$SCRIPT_DIR/kafka-verifiable-share-consumer.sh" "$@"
        ;;

    # Advanced commands
    transactions|transaction)
        exec "$SCRIPT_DIR/kafka-transactions.sh" "$@"
        ;;
    replica-verification|verify-replicas)
        exec "$SCRIPT_DIR/kafka-replica-verification.sh" "$@"
        ;;
    delete-records)
        exec "$SCRIPT_DIR/kafka-delete-records.sh" "$@"
        ;;
    get-offsets|offsets)
        exec "$SCRIPT_DIR/kafka-get-offsets.sh" "$@"
        ;;
    dump-log)
        exec "$SCRIPT_DIR/kafka-dump-log.sh" "$@"
        ;;
    jmx)
        exec "$SCRIPT_DIR/kafka-jmx.sh" "$@"
        ;;
    metadata-shell|shell)
        exec "$SCRIPT_DIR/kafka-metadata-shell.sh" "$@"
        ;;
    streams-resetter|streams-reset)
        exec "$SCRIPT_DIR/kafka-streams-application-reset.sh" "$@"
        ;;

    # Unknown command
    *)
        echo "Error: Unknown command '$COMMAND'"
        echo ""
        echo "Run 'kafka --help' to see available commands"
        exit 1
        ;;
esac
