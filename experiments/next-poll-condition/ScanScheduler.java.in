package org.apache.kafka.clients.consumer.internals;

import java.util.IdentityHashMap;
import java.util.Map;

/** Network-thread-confined scheduler. Unmigrated managers retain full-pass polling. */
public final class RequestManagerScheduler {
    private java.util.List<RequestManager> managers;

    public void registerManagers(java.util.List<RequestManager> managers) {
        this.managers = managers;
    }

    public long pollReady(long nowMs,
            java.util.function.ToLongFunction<NetworkClientDelegate.PollResult> admit) {
        long delay = Long.MAX_VALUE;
        for (RequestManager manager : managers) {
            NetworkClientDelegate.PollResult result = poll(manager, nowMs);
            if (result != null)
                delay = Math.min(delay, admit.applyAsLong(result));
        }
        return Math.min(delay, remainingMs(nowMs));
    }

    private final Map<RequestManager, NextPollCondition> waiting = new IdentityHashMap<>();

    /** Returns null when the manager is still waiting. Never replays an earlier request list. */
    public NetworkClientDelegate.PollResult poll(RequestManager manager, long nowMs) {
        NextPollCondition condition = waiting.get(manager);
        if (condition != null && !condition.isReady(nowMs))
            return null;
        NetworkClientDelegate.PollResult result = manager.poll(nowMs);
        if (result.nextPollCondition == null)
            waiting.remove(manager);
        else
            waiting.put(manager, result.nextPollCondition);
        return result;
    }

    /** Recheck after the pass: a later manager may have changed an earlier manager's input. */
    public long remainingMs(long nowMs) {
        long remaining = Long.MAX_VALUE;
        for (NextPollCondition condition : waiting.values())
            remaining = Math.min(remaining, condition.remainingMs(nowMs));
        return remaining;
    }
}
