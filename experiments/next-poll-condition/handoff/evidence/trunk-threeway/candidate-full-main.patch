+    private Entry entry(RequestManager manager) {
+        Entry result = entries.get(manager);
+        if (result == null) {
+            result = new Entry(manager, entries.size());
+            entries.put(manager, result);
+            entriesByOrder.add(result);
+            ready.set(result.order);
+        }
