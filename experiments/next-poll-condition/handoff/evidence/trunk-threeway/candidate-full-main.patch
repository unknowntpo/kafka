+            Subscription current = first;
+            first = null;
+            last = null;
+            subscriberCount = 0;
+            while (current != null) {
+                Subscription next = current.next;
+                Runnable callback = current.callback;
+                current.callback = null;
+                current.previous = null;
+                current.next = null;
