+package org.apache.kafka.clients.consumer.internals;
+
+import org.junit.jupiter.api.Test;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+public class DeadlineIndexTest {
+    private static NetworkClientDelegate.PollResult result(NextPollCondition condition) {
+        return new NetworkClientDelegate.PollResult(Long.MAX_VALUE, Collections.emptyList(), condition);
+    }
+
+    @Test
+    public void expirationUsesManagerOrderAndRearmsEarliestDeadline() {
+        List<Integer> trace = new ArrayList<>();
+        List<RequestManager> managers = new ArrayList<>();
+        for (int i = 0; i < 7; i++) {
+            final int id = i;
+            managers.add(now -> {
+                trace.add(id);
+                return result(NextPollCondition.after(now, id % 2 == 0 ? 10 : 5));
+            });
+        }
+        try (RequestManagerScheduler scheduler = new RequestManagerScheduler()) {
+            scheduler.registerManagers(managers);
+            assertEquals(5, scheduler.pollReady(0, r -> r.timeUntilNextPollMs));
+            assertEquals(List.of(0, 1, 2, 3, 4, 5, 6), trace);
+            trace.clear();
+            assertEquals(1, scheduler.pollReady(4, r -> r.timeUntilNextPollMs));
+            assertEquals(Collections.emptyList(), trace);
+            assertEquals(5, scheduler.pollReady(5, r -> r.timeUntilNextPollMs));
+            assertEquals(List.of(1, 3, 5), trace);
+            trace.clear();
+            assertEquals(5, scheduler.pollReady(10, r -> r.timeUntilNextPollMs));
+            assertEquals(List.of(0, 1, 2, 3, 4, 5, 6), trace);
+        }
+    }
+
+    @Test
+    public void signalCancellationRemovesOldEarliestDeadline() {
+        NextPollCondition.Signal signal = new NextPollCondition.Signal();
+        int[] polls = {0};
+        RequestManager first = now -> result(polls[0]++ == 0
+            ? NextPollCondition.anyOf(signal.await(), NextPollCondition.after(now, 5))
+            : signal.await());
+        RequestManager second = now -> result(NextPollCondition.after(now, 10));
+        try (RequestManagerScheduler scheduler = new RequestManagerScheduler()) {
+            scheduler.registerManagers(List.of(first, second));
+            assertEquals(5, scheduler.pollReady(0, r -> r.timeUntilNextPollMs));
+            signal.publish();
+            assertEquals(9, scheduler.pollReady(1, r -> r.timeUntilNextPollMs));
+            assertEquals(5, scheduler.remainingMs(5));
+            assertEquals(2, polls[0]);
+        }
+        assertEquals(0, signal.subscriberCount());
+    }
+
+    @Test
+    public void signalDuringBatchDefersNewReadyManager() {
+        NextPollCondition.Signal signal = new NextPollCondition.Signal();
+        List<Integer> trace = new ArrayList<>();
+        RequestManager first = now -> {
+            trace.add(0);
+            if (now > 0)
+                signal.publish();
+            return result(NextPollCondition.after(now, 10));
+        };
+        RequestManager second = now -> {
+            trace.add(1);
+            return result(signal.await());
+        };
+        try (RequestManagerScheduler scheduler = new RequestManagerScheduler()) {
+            scheduler.registerManagers(List.of(first, second));
+            scheduler.pollReady(0, r -> r.timeUntilNextPollMs);
+            trace.clear();
+            assertEquals(0, scheduler.pollReady(10, r -> r.timeUntilNextPollMs));
+            assertEquals(List.of(0), trace);
+            scheduler.pollReady(10, r -> r.timeUntilNextPollMs);
+            assertEquals(List.of(0, 1), trace);
+        }
+    }
+
+    @Test
+    public void maximumDeadlineIsNotTreatedAsMissing() {
+        int[] polls = {0};
+        RequestManager manager = now -> {
+            polls[0]++;
+            return result(NextPollCondition.after(now, Long.MAX_VALUE));
+        };
+        try (RequestManagerScheduler scheduler = new RequestManagerScheduler()) {
+            scheduler.registerManagers(List.of(manager));
+            assertEquals(Long.MAX_VALUE - 10, scheduler.pollReady(10, r -> r.timeUntilNextPollMs));
+            assertEquals(1, scheduler.remainingMs(Long.MAX_VALUE - 1));
+            assertEquals(0, scheduler.pollReady(Long.MAX_VALUE, r -> r.timeUntilNextPollMs));
+            assertEquals(2, polls[0]);
+        }
+    }
+}
