package org.apache.kafka.clients.consumer.internals;

import java.util.List;
import java.util.function.ToLongFunction;

/** Optimistic reference using knowledge of this benchmark's deterministic input schedule.
 * Not a production scheduler, nor a bound applicable to arbitrary workloads. */
public final class RequestManagerScheduler implements AutoCloseable {
    private List<RequestManager> managers;
    private final String pattern = System.getProperty("oracle.pattern", "IDLE");
    private final ApplicationProgress progress = new ApplicationProgress();
    private long pass;
    public ApplicationProgress applicationProgress() { return progress; }
    public void registerManagers(List<RequestManager> entries) { managers = entries; }
    public long pollReady(long now, ToLongFunction<NetworkClientDelegate.PollResult> admit) {
        long current = pass++;
        boolean all = current == 0 || pattern.equals("BUSY") || pattern.equals("TIMER") && current % 64 == 0;
        boolean one = pattern.equals("SPARSE") && current % 64 == 0;
        if (all) {
            for (RequestManager manager : managers) admit.applyAsLong(manager.poll(now));
            progress.publish();
        } else if (one) {
            admit.applyAsLong(managers.get((int) (current / 64 % managers.size())).poll(now));
            progress.publish();
        }
        return pattern.equals("TIMER") ? 64 - current % 64 : Long.MAX_VALUE;
    }
    public void close() { managers = null; }
}
