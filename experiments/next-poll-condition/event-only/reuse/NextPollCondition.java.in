package org.apache.kafka.clients.consumer.internals;

import java.util.Objects;

/**
 * A one-shot condition for the next manager poll. Conditions and signals are confined to the
 * consumer network thread. External input must use the existing event queue and network wakeup.
 */
public interface NextPollCondition {
    /** Register once; subsequent input publication activates the subscriber directly. */
    void register(Registration registration);

    interface Registration {
        void onSignal(Signal signal, long observed);

        void onDeadline(long deadlineMs);
    }

    boolean isReady(long nowMs);

    long remainingMs(long nowMs);

    static NextPollCondition after(long nowMs, long delayMs) {
        if (delayMs < 0)
            throw new IllegalArgumentException("Negative delay");
        long deadline = nowMs > Long.MAX_VALUE - delayMs ? Long.MAX_VALUE : nowMs + delayMs;
        return new NextPollCondition() {
            @Override
            public void register(Registration registration) {
                registration.onDeadline(deadline);
            }

            @Override
            public boolean isReady(long now) {
                return now >= deadline;
            }

            @Override
            public long remainingMs(long now) {
                if (isReady(now))
                    return 0;
                long remaining = deadline - now;
                return remaining < 0 ? Long.MAX_VALUE : remaining;
            }
        };
    }

    /** Either child can activate the manager; nesting preserves the earliest deadline. */
    static NextPollCondition anyOf(NextPollCondition first, NextPollCondition second) {
        Objects.requireNonNull(first);
        Objects.requireNonNull(second);
        return new NextPollCondition() {
            @Override
            public void register(Registration registration) {
                first.register(registration);
                second.register(registration);
            }

            @Override
            public boolean isReady(long now) {
                return first.isReady(now) || second.isReady(now);
            }

            @Override
            public long remainingMs(long now) {
                return Math.min(first.remainingMs(now), second.remainingMs(now));
            }
        };
    }

    /** Capture before producing a poll result so publication before registration is not lost. */
    final class Signal {
        private long generation;
        private Subscription first;
        private Subscription last;
        private int subscriberCount;

        public void publish() {
            generation++;
            Subscription current = first;
            first = null;
            last = null;
            subscriberCount = 0;
            while (current != null) {
                Subscription next = current.next;
                Runnable callback = current.callback;
                current.owner = null;
                current.callback = null;
                current.previous = null;
                current.next = null;
                if (callback != null)
                    callback.run();
                current = next;
            }
        }

        Runnable subscribe(long observed, Runnable subscriber) {
            // Public one-shot cancellation handles are never recycled behind their callers.
            return subscribeReusable(observed, subscriber, null);
        }

        Subscription subscribeReusable(long observed, Runnable subscriber, Subscription slot) {
            if (slot != null)
                slot.run();
            // A detached publication may still be traversing this node. Do not overwrite
            // its next link or make an old publication invoke a newly registered callback.
            if (slot == null || slot.owner != null)
                slot = new Subscription();
            if (generation != observed) {
                subscriber.run();
                return slot;
            }
            slot.owner = this;
            slot.registeredGeneration = generation;
            slot.callback = subscriber;
            slot.previous = last;
            if (last == null)
                first = slot;
            else
                last.next = slot;
            last = slot;
            subscriberCount++;
            return slot;
        }

        int subscriberCount() { return subscriberCount; }

        /** Scheduler-owned reusable slot; a pending publication retains ownership until popped. */
        static final class Subscription implements Runnable {
            private Signal owner;
            private long registeredGeneration;
            private Runnable callback;
            private Subscription previous;
            private Subscription next;

            @Override
            public void run() {
                if (owner == null)
                    return;
                callback = null;
                if (registeredGeneration != owner.generation)
                    return;
                if (previous == null)
                    owner.first = next;
                else
                    previous.next = next;
                if (next == null)
                    owner.last = previous;
                else
                    next.previous = previous;
                owner.subscriberCount--;
                owner = null;
                previous = null;
                next = null;
            }
        }

        public NextPollCondition await() {
            long observed = generation;
            return new NextPollCondition() {
                @Override
                public void register(Registration registration) {
                    registration.onSignal(Signal.this, observed);
                }
                @Override
                public boolean isReady(long now) { return generation != observed; }
                @Override
                public long remainingMs(long now) { return isReady(now) ? 0 : Long.MAX_VALUE; }
            };
        }
    }
}
