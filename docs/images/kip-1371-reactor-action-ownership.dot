digraph ConsumerReactorActionOwnership {
  graph [
    bgcolor="white",
    fontname="Arial",
    fontsize=22,
    label="Inside one ConsumerReactor iteration: publish schedule, then execute actions",
    labelloc="t",
    labeljust="l",
    dpi=160,
    nodesep=0.42,
    ranksep=0.65,
    pad=0.25,
    splines=ortho
  ];

  node [
    shape=box,
    style="rounded,filled",
    fontname="Arial",
    fontsize=13,
    color="#64748b",
    fillcolor="#f8fafc",
    fontcolor="#0f172a",
    margin="0.16,0.11",
    penwidth=1.2
  ];

  edge [
    fontname="Arial",
    fontsize=11,
    color="#475569",
    fontcolor="#334155",
    arrowsize=0.75,
    penwidth=1.2
  ];

  manager [label="RequestManager.poll(now)\nmanager-local state and rules"];
  result [
    label="PollResult\nwork now: unsentRequests + stateTransitions\nnext poll: timeUntilNextPollMs",
    fillcolor="#eff6ff",
    color="#3b82f6"
  ];
  result_factories [
    label="Proposed PollResult factory methods\nconstruct and validate:\nprogress(requests, transitions, delay)\nretryAfter(delayMs)\nawaitEvent()\n\nRejected: no work + immediate retry",
    fillcolor="#fffbeb",
    color="#d97706"
  ];

  subgraph cluster_reactor {
    label="Reactor thread";
    labelloc="t";
    labeljust="l";
    fontsize=15;
    fontname="Arial";
    color="#2563eb";
    penwidth=1.6;
    style="rounded";
    margin=18;

    reactor [
      label="ConsumerReactor\norders inputs and combines manager results",
      fillcolor="#dbeafe",
      color="#2563eb",
      penwidth=1.8
    ];
    schedule [
      label="1. Publish ReactorSchedule\nimmutable deadlines and generation",
      fillcolor="#ecfdf5",
      color="#10b981"
    ];
    executor [
      label="2. ConsumerReactor.executeReactorActions()\nderive or collect, deduplicate equivalent actions,\nand execute after publication",
      fillcolor="#f5f3ff",
      color="#8b5cf6",
      penwidth=1.6
    ];
  }

  network [
    label="NetworkClientDelegate\ndirect request handoff",
    fillcolor="#fff7ed",
    color="#f97316"
  ];

  actions [
    label="3. Application-visible effects\nCOMPLETE_ASYNC_POLL\nNOTIFY_METADATA_ERROR\nWAKE_APPLICATION (last)",
    fillcolor="#faf5ff",
    color="#a855f7"
  ];
  event_destinations [
    label="Event completion destinations\nAsyncPollEvent\nMetadataErrorNotifiableEvent",
    fillcolor="#f8fafc",
    color="#64748b"
  ];
  wake_router [
    label="RequestManagers\nWAKE_APPLICATION routing only",
    fillcolor="#f8fafc",
    color="#64748b"
  ];
  wait_destinations [
    label="Application wait destinations\nFetchBuffer / ShareFetchBuffer",
    fillcolor="#f8fafc",
    color="#64748b"
  ];

  returned [label="returns one snapshot", shape=box, style=filled, fillcolor="white", color="white", fontsize=11, margin="0.05,0.03"];
  manager_facts [label="validated work + next-poll requirement", shape=box, style=filled, fillcolor="white", color="white", fontsize=11, margin="0.05,0.03"];
  publish_first [label="publish first", shape=box, style=filled, fillcolor="white", color="white", fontsize=11, margin="0.05,0.03"];
  published [label="published state is visible", shape=box, style=filled, fillcolor="white", color="white", fontsize=11, margin="0.05,0.03"];
  execute [label="execute on reactor thread", shape=box, style=filled, fillcolor="white", color="white", fontsize=11, margin="0.05,0.03"];
  complete_event [label="complete or fail the input event", shape=box, style=filled, fillcolor="white", color="white", fontsize=11, margin="0.05,0.03"];
  route_wakeup [label="WAKE_APPLICATION only", shape=box, style=filled, fillcolor="white", color="white", fontsize=11, margin="0.05,0.03"];
  wake_waiter [label="dispatch by consumer type", shape=box, style=filled, fillcolor="white", color="white", fontsize=11, margin="0.05,0.03"];
  request_handoff [
    label="unsentRequests\n(not a ReactorAction)",
    shape=box,
    style=filled,
    fillcolor="white",
    color="white",
    fontcolor="#c2410c",
    fontsize=11,
    margin="0.05,0.03"
  ];

  manager -> returned [arrowhead=none];
  returned -> result;
  { rank=same; result; result_factories; }
  result_factories -> result [style=dashed, constraint=false, color="#d97706"];
  result -> manager_facts [arrowhead=none];
  manager_facts -> reactor;
  reactor -> manager [constraint=false];
  reactor -> publish_first [arrowhead=none];
  publish_first -> schedule;
  schedule -> published [arrowhead=none];
  published -> executor;
  executor -> execute [arrowhead=none];
  execute -> actions;
  actions -> complete_event [arrowhead=none];
  complete_event -> event_destinations;
  actions -> route_wakeup [arrowhead=none];
  route_wakeup -> wake_router;
  wake_router -> wake_waiter [arrowhead=none];
  wake_waiter -> wait_destinations;
  reactor -> request_handoff [
    arrowhead=none,
    color="#f97316",
    fontcolor="#c2410c"
  ];
  request_handoff -> network [color="#f97316"];
}
