{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Coordinator-unavailable observation lifecycle",
    "locale": "en",
    "output": "kip-1371-coordinator-observation-sequence.html",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [1080, 620],
    "legend": { "mode": "hidden" },
    "views": [
      {
        "id": "capture-observation",
        "label": "Capture the observation",
        "focus": ["coordinator", "heartbeat", "network", "reactor"],
        "note": "The request captures coordinator version 7; its response reports a fact instead of mutating the owner."
      },
      {
        "id": "route-and-fence",
        "label": "Route and fence",
        "focus": ["reactor", "composition", "coordinator"],
        "note": "The next iteration routes the fact to the single owner, which rejects stale versions."
      },
      {
        "id": "rediscover",
        "label": "Rediscover before I/O",
        "focus": ["coordinator", "composition", "reactor", "network"],
        "note": "The next full manager pass produces FindCoordinator and publishes the wait before the next network poll."
      }
    ]
  },
  "participants": [
    {
      "id": "heartbeat",
      "type": "backend",
      "label": "Heartbeat manager",
      "sublabel": "observation producer"
    },
    {
      "id": "reactor",
      "type": "backend",
      "label": "ConsumerReactor",
      "sublabel": "ordering authority"
    },
    {
      "id": "composition",
      "type": "messagebus",
      "label": "RequestManagers",
      "sublabel": "typed routing"
    },
    {
      "id": "coordinator",
      "type": "database",
      "label": "Coordinator manager",
      "sublabel": "single state owner"
    },
    {
      "id": "network",
      "type": "cloud",
      "label": "NetworkClientDelegate",
      "sublabel": "transport"
    }
  ],
  "segments": [
    {
      "from": 150,
      "to": 290,
      "label": "Build and observe"
    },
    {
      "from": 300,
      "to": 430,
      "label": "Next iteration: route and fence"
    },
    {
      "from": 440,
      "to": 540,
      "label": "Full ordered pass before next network poll"
    }
  ],
  "messages": [
    {
      "id": "publish-snapshot",
      "from": "coordinator",
      "to": "heartbeat",
      "y": 170,
      "label": "CoordinatorSnapshot(node-1, version 7)",
      "variant": "return"
    },
    {
      "id": "send-heartbeat",
      "from": "heartbeat",
      "to": "network",
      "y": 205,
      "label": "Heartbeat(node-1, observedVersion 7)",
      "variant": "emphasis"
    },
    {
      "id": "coordinator-unavailable",
      "from": "network",
      "to": "heartbeat",
      "y": 240,
      "label": "coordinator unavailable",
      "variant": "return"
    },
    {
      "id": "report-fact",
      "from": "heartbeat",
      "to": "reactor",
      "y": 280,
      "label": "PollResult + ManagerEvent(version 7)",
      "variant": "emphasis",
      "note": "Report an immutable fact; do not mutate coordinator state."
    },
    {
      "id": "route-fact",
      "from": "reactor",
      "to": "composition",
      "y": 325,
      "label": "route deferred fact"
    },
    {
      "id": "deliver-owner",
      "from": "composition",
      "to": "coordinator",
      "y": 365,
      "label": "CoordinatorUnavailableObserved(version 7)",
      "variant": "emphasis"
    },
    {
      "id": "fence-version",
      "from": "coordinator",
      "to": "reactor",
      "y": 410,
      "label": "version check: applied or ignored",
      "variant": "security",
      "note": "If current version is 9, ignore the stale observation."
    },
    {
      "id": "ordered-pass",
      "from": "reactor",
      "to": "composition",
      "y": 460,
      "label": "poll all managers in fixed order"
    },
    {
      "id": "find-coordinator-result",
      "from": "coordinator",
      "to": "reactor",
      "y": 495,
      "label": "progress(FindCoordinator)",
      "variant": "return"
    },
    {
      "id": "stage-network-request",
      "from": "reactor",
      "to": "network",
      "y": 530,
      "label": "publish schedule, then hand off",
      "variant": "emphasis"
    }
  ],
  "activations": [
    {
      "participant": "heartbeat",
      "from": 165,
      "to": 286,
      "type": "backend"
    },
    {
      "participant": "reactor",
      "from": 275,
      "to": 538,
      "type": "backend"
    },
    {
      "participant": "composition",
      "from": 318,
      "to": 470,
      "type": "messagebus"
    },
    {
      "participant": "coordinator",
      "from": 358,
      "to": 520,
      "type": "database"
    },
    {
      "participant": "network",
      "from": 198,
      "to": 247,
      "type": "cloud"
    }
  ]
}
