  "cards": [
    {
      "dot": "cyan",
      "title": "Shared execution model",
      "items": [
        "Regular, share, and Streams consumers reuse the same reactor phases",
        "The selected composition retains consumer-specific protocol rules"
      ]
    },
    {
      "dot": "emerald",
      "title": "Manager ownership",
      "items": [
        "Request managers own local mutable state and progress decisions",
        "PollResult carries transport intents, facts, and the next useful poll condition"
      ]
    },
    {
      "dot": "violet",
      "title": "Closed publication loop",
      "items": [
        "ConsumerReactor publishes ReactorSchedule before application-visible effects",
        "Background events, fetch data, and wakeup return control to the application thread"
      ]
    }
  ]
