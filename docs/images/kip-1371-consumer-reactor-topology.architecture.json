  "cards": [
    {
      "dot": "emerald",
      "title": "Case study: coordinator unavailable",
      "items": [
        "Heartbeat reports a versioned observation instead of mutating coordinator state",
        "The coordination policy derives one command; only CoordinatorRequestManager validates and writes"
      ]
    },
    {
      "dot": "violet",
      "title": "Closed publication loop",
      "items": [
        "ConsumerReactor publishes ReactorSchedule before application-visible effects",
        "Background events, fetch data, and wakeup return control to the application thread"
      ]
    }
  ]
