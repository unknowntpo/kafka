digraph Kafka20253Progress {
  graph [
    bgcolor="white",
    fontname="Arial",
    fontsize=22,
    label="KAFKA-20253: coordinator unavailable while heartbeat is due",
    labelloc="t",
    labeljust="l",
    dpi=160,
    nodesep=0.48,
    ranksep=0.55,
    pad=0.25,
    splines=ortho
  ];

  node [
    shape=box,
    style="rounded,filled",
    fontname="Arial",
    fontsize=13,
    color="#64748b",
    fillcolor="#f8fafc",
    fontcolor="#0f172a",
    margin="0.17,0.12",
    penwidth=1.2
  ];

  edge [
    fontname="Arial",
    fontsize=11,
    color="#475569",
    fontcolor="#334155",
    arrowsize=0.75,
    penwidth=1.2
  ];

  input [
    label="Observed state\nheartbeat is due\ncoordinator unavailable",
    fillcolor="#fff7ed",
    color="#f97316"
  ];

  heartbeat [
    label="Heartbeat manager\nno coordinator -> no request\nno application-visible transition",
    fillcolor="#f8fafc"
  ];
  coordinator [
    label="Coordinator manager\nFindCoordinator request in flight\nwait for its completion",
    fillcolor="#f8fafc"
  ];

  decision [
    label="ConsumerReactor decision\nReactorSchedule = wait for network completion\nReactorAction = none",
    fillcolor="#dbeafe",
    color="#2563eb",
    penwidth=1.8
  ];
  no_loop [
    label="No zero-delay poll loop\nNo application wakeup",
    fillcolor="#ecfdf5",
    color="#10b981",
    penwidth=1.6
  ];

  completion [
    label="FindCoordinator response succeeds",
    fillcolor="#fff7ed",
    color="#f97316"
  ];
  owner_update [
    label="Coordinator owner publishes\nthe newly discovered target",
    fillcolor="#eff6ff",
    color="#3b82f6"
  ];
  next_pass [
    label="Next full ordered manager pass\nobserves the current coordinator snapshot",
    fillcolor="#dbeafe",
    color="#2563eb"
  ];
  request [
    label="Heartbeat request can now be created\nrequest goes to NetworkClientDelegate\nstill no synthetic application wakeup",
    fillcolor="#ecfdf5",
    color="#10b981"
  ];

  blocked [label="blocked fact", shape=box, style=filled, fillcolor="white", color="white", fontsize=11, margin="0.05,0.03"];
  in_flight [label="in-flight fact", shape=box, style=filled, fillcolor="white", color="white", fontsize=11, margin="0.05,0.03"];
  no_action [label="publish schedule; execute no action", shape=box, style=filled, fillcolor="white", color="white", fontsize=11, margin="0.05,0.03"];
  progress [label="real progress input", shape=box, style=filled, fillcolor="white", color="white", fontsize=11, margin="0.05,0.03"];
  published [label="owner-local truth published", shape=box, style=filled, fillcolor="white", color="white", fontsize=11, margin="0.05,0.03"];

  input -> heartbeat;
  input -> coordinator;
  heartbeat -> blocked [arrowhead=none];
  blocked -> decision;
  coordinator -> in_flight [arrowhead=none];
  in_flight -> decision;
  decision -> no_action [arrowhead=none];
  no_action -> no_loop;
  no_loop -> progress [arrowhead=none];
  progress -> completion;
  completion -> owner_update;
  owner_update -> published [arrowhead=none];
  published -> next_pass;
  next_pass -> request;
}
