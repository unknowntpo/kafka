flowchart LR
    subgraph CURRENT["Current: wait, deadline, completion, publication, and wakeup decisions are distributed"]
        direction TB

        APP_CURRENT["Application thread<br/>rescan subscription and fetch state<br/>choose application wait"]
        HANDLER["ApplicationEventHandler"]
        APP_QUEUE_CURRENT["ApplicationEventQueue"]
        NETWORK_THREAD["ConsumerNetworkThread<br/>assemble network poll timeout"]
        MANAGERS_CURRENT["RequestManagers<br/>report local deadlines<br/>some paths request wakeup"]
        CALLBACKS_CURRENT["Network response paths<br/>complete futures<br/>publish data or errors · wake"]
        OUTPUTS_CURRENT["Application-visible effects<br/>wait · complete Future<br/>publish data or error · wake"]

        APP_CURRENT --> HANDLER --> APP_QUEUE_CURRENT --> NETWORK_THREAD
        NETWORK_THREAD --> MANAGERS_CURRENT
        NETWORK_THREAD --> CALLBACKS_CURRENT
        APP_CURRENT -. "choose wait" .-> OUTPUTS_CURRENT
        MANAGERS_CURRENT -. "deadline or wake hint" .-> OUTPUTS_CURRENT
        CALLBACKS_CURRENT -. "complete, publish, or wake" .-> OUTPUTS_CURRENT
    end

    subgraph PROPOSED["Proposed: ConsumerReactor combines the final cross-component decisions"]
        direction TB

        APP_PROPOSED["Application thread"]
        GATEWAY["ConsumerReactorGateway"]
        APP_QUEUE_PROPOSED["ApplicationEventQueue"]
        REACTOR["ConsumerReactor<br/><b>final decision owner</b>"]
        PROCESSOR["ApplicationEventProcessor<br/>returns pending ReactorActions"]
        MANAGERS_PROPOSED["RequestManager.poll()<br/>requests · state transitions<br/>timeUntilNextPollMs"]
        NETWORK["NetworkClientDelegate.poll()<br/>completion callbacks mark<br/>affected managers"]
        OWNED["ConsumerReactor decides:<br/>input and manager-poll order<br/>affected-manager post-I/O polling<br/>earliest deadline and network poll timeout<br/>state-transition and action ordering<br/>complete, publish, and wake coalescing"]
        SCHEDULE["Publish ReactorSchedule<br/>reactor and application deadlines<br/>before application-visible actions"]
        ACTION["Execute ReactorAction<br/>complete or publish first<br/>retained wakeup last"]
        OUTPUTS_PROPOSED["FetchBuffer · EventQueue<br/>Future · application wakeup"]

        APP_PROPOSED --> GATEWAY --> APP_QUEUE_PROPOSED --> REACTOR
        REACTOR --> PROCESSOR
        REACTOR <--> MANAGERS_PROPOSED
        REACTOR <--> NETWORK
        REACTOR --> OWNED --> SCHEDULE --> ACTION --> OUTPUTS_PROPOSED
    end

    CURRENT ~~~ PROPOSED

    classDef application fill:#f5f7fa,stroke:#7b8794,color:#172033;
    classDef currentDecision fill:#fff7e6,stroke:#c58a2b,color:#4a3210;
    classDef reactor fill:#dcecff,stroke:#245ea8,stroke-width:3px,color:#102a43;
    classDef schedule fill:#e8f5e9,stroke:#40864a,color:#183b1d;
    classDef action fill:#f1eafe,stroke:#7656a6,color:#2f1d4a;
    classDef decision fill:#e7f0fb,stroke:#245ea8,stroke-width:2px,color:#102a43;

    class APP_CURRENT,APP_PROPOSED application;
    class MANAGERS_CURRENT,CALLBACKS_CURRENT,OUTPUTS_CURRENT currentDecision;
    class REACTOR reactor;
    class OWNED decision;
    class SCHEDULE schedule;
    class ACTION action;
